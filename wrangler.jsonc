{
  "name": "imrc-panel-dns",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "imrc-db",
      "database_id": "1727b34f-d1c9-4d5c-91b8-06dbb5b162da"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
